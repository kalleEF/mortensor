\itemize{
\item \code{core = "exponential"} (the core model of the paper's applications):
\verb{rho[x, t] ~ N(exp(b1[x] + b2[x] log t), sigma^2)}, \code{b1[x] ~ N(theta1[x], sigma1^2)}, \code{b2[x] ~ N(theta2[x], sigma2^2)}, with
